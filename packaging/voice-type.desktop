# Install into ~/.local/share/applications/ (visible in the app menu).
# Prefer: bash scripts/install_linux_launchers.sh
# Then fix Exec= to your install path if you copy by hand.
[Desktop Entry]
Type=Application
Name=voice-type
GenericName=Voice typing
Comment=离线语音输入（右 Alt 开始/结束）
Exec=/path/to/voice-type/voice-type
TryExec=/path/to/voice-type/voice-type
Icon=audio-input-microphone
Terminal=false
Categories=Utility;AudioVideo;
Keywords=voice;dictation;asr;语音;
StartupNotify=false
